# NODE_ENV=development
# PORT=5000
# CLIENT_URL=http://localhost:5173
# PUBLIC_FRONTEND_URL=http://localhost:5173
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
# SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
# REQUEST_AUDIT_LOG_DIR=.private/audit-logs
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=12
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=100
# DELEGATE_REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
# DELEGATE_REGISTRATION_RATE_LIMIT_MAX=100
# COMMERCIAL_APPLICATION_RATE_LIMIT_WINDOW_MS=900000
# COMMERCIAL_APPLICATION_RATE_LIMIT_MAX=100
# ABSTRACT_SUBMISSION_DEADLINE=2027-03-15T23:59:59+01:00
# ABSTRACT_CONTINUATION_TOKEN_TTL_HOURS=24
# ABSTRACT_RECOVERY_TOKEN_TTL_MINUTES=30
# ABSTRACT_RATE_LIMIT_WINDOW_MS=900000
# ABSTRACT_RATE_LIMIT_MAX=100
# ENQUIRY_RATE_LIMIT_WINDOW_MS=900000
# ENQUIRY_RATE_LIMIT_MAX=100
# ENQUIRY_NOTIFICATION_ROLES=SUPER_ADMIN,COMMUNICATIONS
# STUDENT_EVIDENCE_ENABLED=true
# Set false to pause evidence upload/retrieval/submission without selecting storage/scanner providers.
# In production, use an existing, persistent private directory outside the release/web roots,
# owned by the API user and mode 0700. The API will not create this directory at startup.
# STUDENT_EVIDENCE_STORAGE_DIR=/var/lib/aiaiac/student-evidence
# Local ClamAV clamd Unix socket, accessible to the API user; clamd must be running.
# STUDENT_EVIDENCE_CLAMD_SOCKET=/run/clamav/clamd.ctl
# STUDENT_EVIDENCE_TOKEN_TTL_HOURS=24
# STUDENT_EVIDENCE_RATE_LIMIT_WINDOW_MS=900000
# STUDENT_EVIDENCE_RATE_LIMIT_MAX=100
# STUDENT_VERIFICATION_RECOVERY_TOKEN_TTL_MINUTES=30
# STUDENT_VERIFICATION_WORKFLOW_RATE_LIMIT_WINDOW_MS=900000
# STUDENT_VERIFICATION_WORKFLOW_RATE_LIMIT_MAX=100
# ADMIN_INVITATION_RATE_LIMIT_WINDOW_MS=900000
# ADMIN_INVITATION_VALIDATE_RATE_LIMIT_MAX=500
# ADMIN_INVITATION_ACCEPT_RATE_LIMIT_MAX=100
# ADMIN_INVITATION_EXPIRY_HOURS=48
# ADMIN_ALLOWED_EMAIL_DOMAINS=aiaiacafrica.com,aiaiacwestafrica.com
# ADMIN_FRONTEND_URL=http://localhost:5173

# Transactional Admin invitation email. Never expose these values to Vite/frontend code.
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=no-reply@example.com
# MAILJET_FROM_NAME=AIAIAC

# Bulk campaign confirmation/delivery is disabled until recipient consent/policy and Mailjet
# sending limits are approved. Test-send and preview are separate from this switch.
# COMMUNICATIONS_BULK_SEND_ENABLED=false

# Paystack server-side test configuration. Never expose this key to Vite/frontend code.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=http://localhost:5173/registration/payment/callback
# PAYMENT_NOTIFICATION_ROLES=SUPER_ADMIN
# REGISTRATION_NOTIFICATION_ROLES=SUPER_ADMIN,ADMIN
# REGISTRATION_NOTIFICATION_EMAIL=register@aiaiacafrica.com
# REGISTRATION_RECOVERY_TOKEN_TTL_MINUTES=30
# REGISTRATION_CONTINUATION_TOKEN_TTL_HOURS=24
# REGISTRATION_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
# REGISTRATION_RECOVERY_RATE_LIMIT_MAX=8

# Set these temporarily only when running npm run admin:create-super, then remove them.
# INITIAL_SUPER_ADMIN_NAME=Conference Owner
# INITIAL_SUPER_ADMIN_EMAIL=owner@example.com
# INITIAL_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Communications Center: leave bulk delivery disabled until controlled activation.
# COMMUNICATIONS_PUBLIC_API_URL=https://api.aiaiacafrica.com
# COMMUNICATIONS_UNSUBSCRIBE_SECRET=<independent random secret of at least 32 characters>
# COMMUNICATIONS_MAILJET_WEBHOOK_SECRET=<independent random secret of at least 32 characters>
# Optional Abstract AI: disabled until explicit approval and complete backend configuration.
ABSTRACT_AI_ENABLED=false
ABSTRACT_AI_DATA_APPROVED=false
ABSTRACT_AI_PROVIDER=openai
# OpenAI application credential only.
ABSTRACT_AI_API_KEY=
# Separate Gemini APPLICATION credential. Never GEMINI_API_KEY_TEST or a frontend variable.
ABSTRACT_AI_GEMINI_API_KEY=
# Gemini requires manual pricing approval and an ISO UTC expiry no more than 30 days ahead.
ABSTRACT_AI_PRICING_CONFIRMED=false
ABSTRACT_AI_PRICING_APPROVED_UNTIL=
ABSTRACT_AI_MODEL=
ABSTRACT_AI_INPUT_USD_PER_MILLION=
ABSTRACT_AI_OUTPUT_USD_PER_MILLION=
ABSTRACT_AI_DAILY_BUDGET_USD=
ABSTRACT_AI_TOTAL_BUDGET_USD=
ABSTRACT_AI_MAX_ATTEMPTS=3
ABSTRACT_AI_MAX_CONCURRENT=1
ABSTRACT_AI_REQUESTS_PER_MINUTE=6
ABSTRACT_AI_TIMEOUT_MS=60000
ABSTRACT_AI_MAX_OUTPUT_TOKENS=2000
# Optional JSON: version, status DRAFT, and integer weights totaling 100.
# ABSTRACT_AI_RUBRIC_JSON=

# Optional Flutterwave Standard v3 (all three enable the gateway; backend only)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_CALLBACK_URL=
