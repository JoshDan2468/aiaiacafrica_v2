NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:5173,http://localhost:5174
PUBLIC_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
TRUST_PROXY_HOPS=0
STUDENT_EVIDENCE_ENABLED=true
COMMUNICATIONS_BULK_SEND_ENABLED=false
# Additional supported settings: backend/.env.example
# Mailjet and Paystack credentials are needed for emails/payments.
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=http://localhost:5173/registration/payment/callback

# For hosted Admin on a different base domain; requires HTTPS (including local dev).
SESSION_COOKIE_SAME_SITE=lax

# Communications Center: leave bulk delivery disabled until controlled activation.
# COMMUNICATIONS_PUBLIC_API_URL=https://api.aiaiacafrica.com
# COMMUNICATIONS_UNSUBSCRIBE_SECRET=<independent random secret of at least 32 characters>
# COMMUNICATIONS_MAILJET_WEBHOOK_SECRET=<independent random secret of at least 32 characters>

# Optional Flutterwave Standard v3 (all three enable the gateway; backend only)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_CALLBACK_URL=
