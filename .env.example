# Compose settings. Use a hex password so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex
BACKEND_IMAGE=docker.io/jaydee23/aiaiac-backend
BACKEND_VERSION=0.1.0
BACKEND_ENV_FILE=./deploy/backend.env
BACKEND_PORT=5000
# On InterServer set COMPOSE_FILE=compose.yaml:compose.interserver.yaml
# Docker Hub repository: jaydee23/aiaiac-backend
# API_DOMAIN=api.example.com
